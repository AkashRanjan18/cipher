{
  "name": "pbt",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@pbt/web",
    "build": "npm run build --workspace=@pbt/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@pbt/web"
  }
}
